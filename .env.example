# ─── Coolify 주입용 환경변수 템플릿 ───
# 실제 값은 커밋하지 않는다. Coolify 환경변수 설정에서 주입하고,
# 로컬 개발 시에만 이 파일을 .env 로 복사해 사용한다.

# PostgreSQL 자격증명
POSTGRES_USER=erd
POSTGRES_PASSWORD=change-me
POSTGRES_DB=erd_studio

# 로컬 개발 시 app 노출 포트 (docker-compose.override.yml 전용 — Coolify 배포에선 미사용)
WEB_PORT=8080

# ─── DDL 임포트 도메인 자동 분류 (선택) ───
# 비워 두면 키워드 사전 + 가중치 방식으로 동작한다.
# 키를 넣으면 LLM 으로 분류하고, 호출 실패 시 사전 방식으로 자동 폴백한다.
# 키 발급: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# 자동 생성 도메인 최대 개수
ERD_MAX_DOMAINS=12
